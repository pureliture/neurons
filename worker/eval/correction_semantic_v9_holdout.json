{"id":"h9-10","content":"[security]\npermit_anonymous = false\n","scope_description":"security.permit_anonymous의 설정값","claims":[["yes","permit_anonymous는 true다."],["no","permit_anonymous는 false다."]],"required_capability":"repository_content","expected_value":"no"},
