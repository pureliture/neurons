{"schema_version":"semantic_holdout.v7","cases":[
{"id":"h7-01","content":"[decoder]\nnewline_mode = 'lf'\n","scope_description":"이 설정의 decoder.newline_mode","claims":[["lf","decoder.newline_mode는 lf다."],["crlf","decoder.newline_mode는 crlf다."]],"required_capability":"repository_content","expected_value":"lf"},
{"id":"h7-02","content":"def clamp_upper(value):\n    return min(value, 17)\n","scope_description":"clamp_upper가 사용하는 상한","claims":[["nine","코드의 상한은 9다."],["seventeen","코드의 상한은 17이다."]],"required_capability":"repository_content","expected_value":"seventeen"},
{"id":"h7-03","content":"CREATE TABLE links (parent_id INTEGER REFERENCES parents(id) ON DELETE RESTRICT);","scope_description":"links.parent_id FK의 삭제 동작","claims":[["restrict","FK의 ON DELETE 동작은 RESTRICT다."],["cascade","FK의 ON DELETE 동작은 CASCADE다."]],"required_capability":"repository_content","expected_value":"restrict"},
{"id":"h7-04","content":"record_format: yaml\ncompression: none\n","scope_description":"이 설정의 record_format","claims":[["json","record_format은 json이다."],["yaml","record_format은 yaml이다."]],"required_capability":"repository_content","expected_value":"yaml"},
{"id":"h7-05","content":"def first_index(values, item):\n    return values.index(item)\n","scope_description":"first_index가 호출하는 목록 메서드","claims":[["index","코드는 values.index를 호출한다."],["count","코드는 values.count를 호출한다."]],"required_capability":"repository_content","expected_value":"index"},
{"id":"h7-06","content":"CREATE TABLE tasks (attempts INTEGER NOT NULL DEFAULT 0);","scope_description":"tasks.attempts의 NULL 허용 여부","claims":[["nullable","attempts는 NULL을 허용한다."],["notnull","attempts는 NOT NULL이다."]],"required_capability":"repository_content","expected_value":"notnull"},
{"id":"h7-07","content":"[writer]\nflush_after_rows = 24\n","scope_description":"writer.flush_after_rows 설정","claims":[["24","flush_after_rows는 24다."],["48","flush_after_rows는 48이다."]],"required_capability":"repository_content","expected_value":"24"},
{"id":"h7-08","content":"def positive_names(entries):\n    return [entry.name for entry in entries if entry.count > 0]\n","scope_description":"positive_names의 entry.count 필터 조건","claims":[["negative","코드는 entry.count가 0보다 작은 항목을 고른다."],["positive","코드는 entry.count가 0보다 큰 항목을 고른다."]],"required_capability":"repository_content","expected_value":"positive"},
{"id":"h7-09","content":"입력 record의 수정은 새 revision을 추가하는 방식으로 처리한다. 과거 revision은 보존한다.","scope_description":"문서가 정한 과거 revision 보존 여부","claims":[["preserve","문서는 과거 revision을 보존하도록 정한다."],["delete","문서는 과거 revision을 삭제하도록 정한다."]],"required_capability":"repository_content","expected_value":"preserve"},
{"id":"h7-10","content":"def label_result(ok):\n    return 'accepted' if ok else 'rejected'\n","scope_description":"label_result에서 ok가 false일 때 반환하는 문자열","claims":[["accepted","ok가 false이면 accepted를 반환한다."],["rejected","ok가 false이면 rejected를 반환한다."]],"required_capability":"repository_content","expected_value":"rejected"},
{"id":"h7-11","content":"snapshot_mode = 'incremental'\nverify_on_read = True\n","scope_description":"이 파일의 snapshot_mode","claims":[["incremental","snapshot_mode는 incremental이다."],["full","snapshot_mode는 full이다."]],"required_capability":"repository_content","expected_value":"incremental"},
{"id":"h7-12","content":"CREATE UNIQUE INDEX unique_revision ON versions(project, revision);","scope_description":"unique_revision index가 다루는 column","claims":[["name","index column은 project와 name이다."],["revision","index column은 project와 revision이다."]],"required_capability":"repository_content","expected_value":"revision"},
{"id":"h7-13","content":"def prefix_ids(items):\n    return ['item_' + str(item.id) for item in items]\n","scope_description":"prefix_ids가 ID 앞에 붙이는 prefix","claims":[["item","코드의 prefix는 item_이다."],["entry","코드의 prefix는 entry_이다."]],"required_capability":"repository_content","expected_value":"item"},
{"id":"h7-14","content":"version: release-8\nprevious_version: release-3\n","scope_description":"이 설정의 현재 version","claims":[["release3","현재 version은 release-3이다."],["release8","현재 version은 release-8이다."]],"required_capability":"repository_content","expected_value":"release8"},
{"id":"h7-15","content":"def has_members(group):\n    return bool(group.members)\n","scope_description":"has_members의 반환 자료형","claims":[["boolean","코드는 bool 값을 반환한다."],["string","코드는 문자열을 반환한다."]],"required_capability":"repository_content","expected_value":"boolean"},
{"id":"h7-16","content":"[retry]\nbackoff_mode = 'exponential'\n","scope_description":"retry.backoff_mode 설정","claims":[["linear","backoff_mode는 linear다."],["exponential","backoff_mode는 exponential이다."]],"required_capability":"repository_content","expected_value":"exponential"},
{"id":"h7-17","content":"호환되지 않는 schema version을 받으면 요청을 거부한다. 자동 변환은 수행하지 않는다.","scope_description":"문서가 정한 호환되지 않는 schema 처리","claims":[["reject","호환되지 않는 schema 요청은 거부한다."],["convert","호환되지 않는 schema 요청을 자동 변환한다."]],"required_capability":"repository_content","expected_value":"reject"},
{"id":"h7-18","content":"def last_item(values):\n    return values[-1]\n","scope_description":"last_item이 고르는 목록 위치","claims":[["first","코드는 목록의 첫 항목을 고른다."],["last","코드는 목록의 마지막 항목을 고른다."]],"required_capability":"repository_content","expected_value":"last"},
{"id":"h7-19","content":"CREATE TABLE runs (finished BOOLEAN DEFAULT FALSE);","scope_description":"runs.finished의 기본값","claims":[["false","finished의 기본값은 FALSE다."],["true","finished의 기본값은 TRUE다."]],"required_capability":"repository_content","expected_value":"false"},
{"id":"h7-20","content":"def normalized_key(text):\n    return text.strip().lower()\n","scope_description":"normalized_key가 적용하는 대소문자 변환","claims":[["upper","코드는 대문자로 변환한다."],["lower","코드는 소문자로 변환한다."]],"required_capability":"repository_content","expected_value":"lower"},
